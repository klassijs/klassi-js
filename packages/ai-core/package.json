{
  "name": "@klassijs/ai-core",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral AI evaluation contracts for Klassi-JS",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node ./scripts/check-no-provider-sdk.mjs",
    "test": "pnpm build && node --test test/*.test.js",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
