{
  "name": "klassi-js",
  "version": "6.1.5",
  "description": "A debuggable Javascript testing framework using webdriverio",
  "creator": {
    "name": "Larry Goddard",
    "email": "larryg@klassitech.co.uk",
    "X": "https://twitter.com/larryG_01",
    "linkedin": "https://linkedin.com/in/larryg",
    "youtube": "https://youtube.com/@LarryG_01"
  }
,
  "contributors": [
    {
      "name": "Carlos Bermejo",
      "github": "https://github.com/carlosbermejop"
    }
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "api testing",
    "bdd",
    "lambdatest",
    "cucumber-js",
    "javascript",
    "testing framework",
    "test automation",
    "webdriverio"
  ],
  "repository": {
    "type": "git",
    "url": "hhtps://github.com/klassijs/klassi-js"
  },
  "main": "index.js",
  "scripts": {
    "manualcirun": "./runtime/scripts/manualTrigger.sh",
    "test:checkin": "jest __tests__/unit",
    "test:merge": "jest __tests__/integration",
    "pkgcheck": "pnpm install --frozen-lockfile",
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm lint:all",
    "lint:all": "pnpm lint-staged && pnpm lint:gherkin",
    "lint-branch-name": "pnpm branch-name-lint ./branchnamelinter.config.json",
    "lint:fix": "eslint --quiet --fix --config runtime/coding-standards/eslint/eslint.config.js **/*.js",
    "gherkin": "gherklin && echo \"Linted feature files in runtime/scripts/features\"",
    "changelog": "standard-version --skip.commit --skip.tag",
    "changelog:patch": "standard-version --release-as patch --skip.commit --skip.tag",
    "changelog:minor": "standard-version --release-as minor --skip.commit --skip.tag",
    "changelog:major": "standard-version --release-as major --skip.commit --skip.tag",
    "cilts3r": "node ./index.js --disableReport --tags @s3 --remoteService lambdatest --extraSettings"
  },
  "homepage": "https://github.com/klassijs/klassi-js#readme",
  "bugs": {
    "url": "https://github.com/klassijs/klassi-js/issues"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1008.0",
    "@aws-sdk/client-ses": "3.1008.0",
    "@cucumber/cucumber": "12.7.0",
    "@cucumber/pretty-formatter": "3.2.0",
    "@eslint/js": "10.0.1",
    "async": "3.2.6",
    "branch-name-lint": "3.0.1",
    "chai": "6.2.2",
    "commander": "14.0.3",
    "cosmiconfig": "9.0.1",
    "dotenv": "17.3.1",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.3",
    "fs-extra": "11.3.4",
    "gherklin": "github:klassijs/klassijs-gherkin",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "klassijs-a11y-validator": "1.1.0",
    "klassijs-astellen": "1.0.1",
    "klassijs-cucumber-html-reporter": "6.1.0",
    "klassijs-smart-ocr": "github:klassijs/klassijs-smart-ocr",
    "klassijs-soft-assert": "^1.3.0",
    "klassijs-visual-validation": "^1.2.4",
    "lint-staged": "16.3.3",
    "merge": "2.1.1",
    "nodemailer": "8.0.2",
    "pactum": "3.9.1",
    "prettier": "3.8.1",
    "recursive-readdir": "2.2.3",
    "require-dir": "1.2.0",
    "standard-version": "github:klassijs/standard-version",
    "text-files-loader": "1.0.5",
    "tsx": "4.21.0",
    "webdriverio": "9.25.0"
  },
  "lint-staged": {
    "**/*.js": "eslint --quiet --fix --config runtime/coding-standards/eslint/eslint.config.js"
  },
  "jest-junit": {
    "suiteName": "Klassi Unit tests",
    "outputDirectory": "./reports",
    "outputName": "junit.xml",
    "uniqueOutputName": "false"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.4",
    "@commitlint/config-conventional": "20.4.4",
    "jest": "30.3.0",
    "jest-junit": "16.0.0"
  }
}