# AWS credentials for S3 bucket access
S3_KEY=AWS-ACCESS-KEY-FOR-S3-BUCKET-ACCESS
S3_SECRET=AWS-SECRET-KEY-FOR-S3-BUCKET-ACCESS

# AWS credentials for SES email sending
SES_KEY=AWS-ACCESS-KEY-FOR-SES-ACCESS
SES_SECRET=AWS-SECRET-KEY-FOR-SES-ACCESS

LAMBDATEST_USERNAME=YOUR-LAMBDATEST-USERNAME
LAMBDATEST_API_URL=YOUR-LAMBDATEST-API-URL
LAMBDATEST_ACCESS_KEY=YOUR-LAMBDATEST-ACCESS-KEY

#Zephyr Credentials
ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# Azure OpenAI evaluation. Set these in the environment; do not commit real values.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
AZURE_OPENAI_JUDGE_DEPLOYMENT=YOUR_JUDGE_DEPLOYMENT_NAME

# Folder shared with Test Genie. Push to wDrive writes bundle.json here.
KLASSI_WDRIVE=/path/to/wDrive

# Import opens this product in Chrome and binds locators from the rendered DOM.
PRODUCT_BASE_URL=https://your-product.example
# PRODUCT_START_PATH=/
# PRODUCT_LOGIN_URL=https://your-product.example/login
# PRODUCT_USER=
# PRODUCT_PASSWORD=
# CHROME_BINARY=/path/to/chrome

